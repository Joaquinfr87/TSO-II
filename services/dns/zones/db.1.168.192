; Zona inversa para 192.168.1.0/24
$TTL    604800
@       IN      SOA     ns1.sudoers.local. admin.sudoers.local. (
                        2026090801      ; Serial (YYYYMMDDNN)
                        604800          ; Refresh
                        86400           ; Retry
                        2419200         ; Expire
                        604800 )        ; Negative Cache TTL

; Nameservers
@               IN      NS      ns1.sudoers.local.

; Registros PTR - Resolución inversa
10              IN      PTR     ns1.sudoers.local.
10              IN      PTR     dns.sudoers.local.
10              IN      PTR     web.sudoers.local.
10              IN      PTR     mail.sudoers.local.
10              IN      PTR     files.sudoers.local.
10              IN      PTR     print.sudoers.local.
