#
# /etc/postfix/master.cf — Solo las líneas que agregamos/modificamos
# El entrypoint.sh toma el default de Debian y agrega estas líneas
#
# NO usar este archivo directamente, es documentación.
# La configuración real la hace entrypoint.sh con sed.
#

# Puerto 587: Submission (clientes envían con autenticación)
#submission inet n       -       n       -       -       smtpd
#  -o syslog_name=postfix/submission
#  -o smtpd_tls_security_level=encrypt
#  -o smtpd_sasl_auth_enable=yes
#  -o smtpd_sasl_type=dovecot
#  -o smtpd_sasl_path=private/auth
#  -o smtpd_recipient_restrictions=permit_sasl_authenticated,reject
#  -o milter_macro_daemon_name=ORIGINATING
