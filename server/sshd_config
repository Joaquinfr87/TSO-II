# ===================================================================
# sshd_config — SSH del servidor TSO-II
# ===================================================================
# Aplicar en el servidor:
#   sudo cp sshd_config /etc/ssh/sshd_config
#   sudo systemctl restart ssh
#
# Acceso por CONTRASEÑA (no se requiere clave), SOLO desde la red
# administrativa 192.168.0.0/24 y SOLO para nicolas, david y joaquin.
# Root tiene acceso denegado.
# ===================================================================

# ─── Acceso ───
PermitRootLogin no
PasswordAuthentication yes
PubkeyAuthentication yes
AllowUsers joaquin david nicolas

# Solo permitir acceso desde la red administrativa 192.168.0.0/24.
# Desde cualquier otra red se deshabilitan TODOS los métodos de
# autenticación (el firewall del host también bloquea SSH fuera de
# esa red; esto es una segunda capa).
Match Address !192.168.0.0/24
    PasswordAuthentication no
    PubkeyAuthentication no

# ─── Límites de sesión ───
MaxAuthTries 3
LoginGraceTime 30
MaxSessions 5

# ─── Keepalive ───
ClientAliveInterval 300
ClientAliveCountMax 2

# ─── Deshabilitar forwarding innecesario ───
AllowTcpForwarding no
AllowAgentForwarding no
X11Forwarding no
PermitTunnel no
GatewayPorts no

# ─── Logging ───
LogLevel VERBOSE
SyslogFacility AUTH

# ─── Puerto y red ───
Port 22
ListenAddress 0.0.0.0