# Archivo de ejemplo para las variables de entorno del proyecto.
# Copiar a `.env` y completar con los valores de cada máquina.
# `.env` está en .gitignore: NO subirlo al repositorio.

# --- Red del servidor físicas ---
# IP de la interfaz del servidor en la red local
HOST_IP=192.168.100.39

# --- DNS (Bind9) ---
# Dominio interno que resolverá el servidor DNS
DNS_DOMAIN=sudoers.local
# IP del servidor DNS (dejar vacío para auto-detección)
# Útil cuando el servidor cambia de red frecuentemente
DNS_SERVER_IP=
#DNS_SERVER_IP=192.168.100.39

# --- Web (Nginx) ---
# Directorio de contenido publicado
WEB_SITE_DIR=./services/web/public
# Puerto del host donde se expone el sitio
WEB_PORT_HTTP=8080

# --- Archivos (Samba) ---
# Directorio compartido
FILES_SHARE_DIR=./services/files/data
# Puerto del host para SMB (445)
SMB_PORT_445=445

# --- Correo ---
# Dominio de correo
MAIL_DOMAIN=mail.sudoers.local

# --- Impresión (CUPS) ---
# Puerto de la interfaz web de CUPS (1631 evita conflicto con CUPS del host)
CUPS_PORT=1631
# Usuario y contraseña del administrador de CUPS
CUPS_ADMIN_USER=admin
CUPS_ADMIN_PASS=admin

# --- Repartición / estado ---
# (información documental, ver teams/)
