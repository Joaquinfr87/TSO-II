# Archivo de ejemplo para las variables de entorno del proyecto.
# Copiar a `.env` y completar con los valores de cada máquina.
# `.env` está en .gitignore: NO subirlo al repositorio.

# --- Red del servidor físicas ---
# IP de la interfaz del servidor en la red local
HOST_IP=192.168.100.39

# --- DNS (Bind9) ---
# Dominio interno que resolverá el servidor DNS
DNS_DOMAIN=sudoers.lan
# IPs del servidor DNS por interfaz (dejar vacío para auto-detección)
# Útil cuando el servidor tiene 2 interfaces (WiFi + LAN)
DNS_IP_WLO1=
DNS_IP_ENO1=

# --- DHCP (Kea) ---
# Red que atiende el servidor DHCP
DHCP_SUBNET=192.168.1.0/24
# Rango de IPs que entrega a los clientes
DHCP_POOL=192.168.1.100 - 192.168.1.200
# IP del servidor DNS que se envía a los clientes
DHCP_DNS=192.168.1.10

# --- Web (Nginx) ---
# Directorio de contenido publicado
WEB_SITE_DIR=./services/web/public
# Puerto del host donde se expone el sitio
WEB_PORT_HTTP=8080

# --- Archivos (Samba) ---
# Directorio compartido
FILES_SHARE_DIR=./services/files/data
# Puerto del host para SMB (445)
SMB_PORT_445=445

# --- Correo ---
# Dominio de correo
MAIL_DOMAIN=mail.sudoers.lan

# --- Impresión (CUPS) ---
# Puerto de la interfaz web de CUPS (1631 evita conflicto con CUPS del host)
CUPS_PORT=1631
# Usuario y contraseña del administrador de CUPS
CUPS_ADMIN_USER=admin
CUPS_ADMIN_PASS=admin

# --- Base de datos (PostgreSQL) ---
# Puerto expuesto de PostgreSQL
DB_PORT=5432
# Usuario, contraseña y base por defecto (CAMBIAR antes de producción)
POSTGRES_USER=tso
POSTGRES_PASSWORD=tso
POSTGRES_DB=tso

# --- Portainer (panel de gestión Docker) ---
# Puerto de la interfaz web (HTTPS)
PORTAINER_PORT=9443

# --- Repartición / estado ---
# (información documental, ver teams/)
